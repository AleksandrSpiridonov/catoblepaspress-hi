filters:
  and:
    - file.inFolder("authors")
    - file.ext == "md"
    - file.name != "index"
formulas:
  author: link(file.path, note.title)
properties:
  formula.author:
    displayName: नाम
  tags:
    displayName: टैग
  books:
    displayName: पुस्तकें
views:
  - type: cards
    name: लेखक
    order:
      - tags
    sort:
      - property: title
        direction: ASC
    image: note.avatar
    imageAspectRatio: 1
    imageFit: cover
    cardSize: 180
  - type: table
    name: तालिका
    order:
      - formula.author
      - tags
      - books
    sort:
      - property: title
        direction: ASC
