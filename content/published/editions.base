filters:
  and:
    - file.inFolder("published")
    - file.ext == "md"
    - file.name != "index"
    - file.hasProperty("author")
formulas:
  book: link(file.path, note.title)
properties:
  formula.book:
    displayName: शीर्षक
  author:
    displayName: लेखक
  year:
    displayName: वर्ष
  status:
    displayName: स्थिति
  formats:
    displayName: प्रारूप
views:
  - type: cards
    name: कार्ड
    order:
      - author
      - year
      - status
      - formats
    sort:
      - property: year
        direction: DESC
    image: note.cover
    imageAspectRatio: 1
    imageFit: contain
    cardSize: 230
  - type: table
    name: तालिका
    order:
      - formula.book
      - author
      - year
      - status
      - formats
    sort:
      - property: year
        direction: DESC
